{
  "name": "e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Charlotte Wealth End-to-End Testing with Playwright, Cucumber, and Serenity/JS",
  "scripts": {
    "test": "cross-env CUCUMBER_SUPPRESS_NODE_WARNING=true cucumber-js",
    "test:all": "npm run test:api && npm run test:web && npm run test:mobile",
    "test:web": "cross-env CUCUMBER_SUPPRESS_NODE_WARNING=true cucumber-js --profile web",
    "test:api": "cross-env CUCUMBER_SUPPRESS_NODE_WARNING=true cucumber-js --profile api",
    "test:mobile": "cross-env CUCUMBER_SUPPRESS_NODE_WARNING=true cucumber-js --profile mobile",
    "test:headed": "cross-env CUCUMBER_SUPPRESS_NODE_WARNING=true HEADLESS=false cucumber-js",
    "test:appium": "wdio run wdio.conf.ts",
    "test:appium:android": "wdio run ./appium/config/wdio.android.conf.ts",
    "test:appium:ios": "wdio run ./appium/config/wdio.ios.conf.ts",
    "appium": "appium",
    "appium:drivers": "appium driver list",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.appium.json",
    "test:report": "serenity-bdd run",
    "serenity:update": "serenity-bdd update"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.64.1",
    "@serenity-js/assertions": "^3.49.0",
    "@serenity-js/console-reporter": "^3.49.0",
    "@serenity-js/core": "^3.49.0",
    "@serenity-js/cucumber": "^3.49.0",
    "@serenity-js/playwright": "^3.49.0",
    "@serenity-js/rest": "^3.49.0",
    "@serenity-js/serenity-bdd": "^3.49.0",
    "@serenity-js/web": "^3.49.0",
    "@types/node": "^24.19.2",
    "@wdio/appium-service": "^10.1.1",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.3",
    "appium-xcuitest-driver": "^12.22.8",
    "cross-env": "^7.0.3",
    "expect-webdriverio": "^8.0.0",
    "playwright": "^1.64.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webdriverio": "^10.1.0"
  }
}
