# ==============================================================================
# Charlotte Wealth API - Environment Variables Template
# Copy this file to .env in repo root or this directory and configure values.
# NEVER commit the actual .env file containing live secrets to version control.
# ==============================================================================

ENVIRONMENT=development
PORT=3000

# Backend API Authorization Key
# A high-entropy 256-bit hexadecimal string used to authorize internal service requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_API_KEY=your-backend-api-key-here

# Thailand SEC API Subscription Key (https://api.sec.or.th)
SEC_SUBSCRIPTION_KEY=your-sec-subscription-key-here

# Google Spreadsheet Identifiers
GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id-here
GOOGLE_PVD_SPREADSHEET_ID=your-google-pvd-spreadsheet-id-here

# SEC PVD Service Config
SEC_PVD_PROJ_ID=your-sec-pvd-proj-id-here
SEC_PVD_BASE_URL=https://api.sec.or.th/v1/pvd
