{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "angular",
      "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/web/browser",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/backend/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/portfolio/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/share-lot/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/price/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/nav/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(chunk-.*\\.js|main-.*\\.js|styles-.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
