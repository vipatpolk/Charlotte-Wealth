# ==============================================================================
# Charlotte Wealth - Environment Variables Template
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file containing live secrets to version control.
# ==============================================================================

# Application Environment (development, test, production)
ENVIRONMENT=development
PORT=3000

# Backend API Authorization Key
# A high-entropy 256-bit hexadecimal string used to authorize internal service requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_API_KEY=your-backend-api-key-here

# E2E Test Suite Client Key (must match BACKEND_API_KEY for authorized requests)
API_KEY=your-backend-api-key-here
API_BASE_URL=http://localhost:3000

# Thailand Securities and Exchange Commission (SEC) API Subscription Key
# Obtain from https://api.sec.or.th developer portal
SEC_SUBSCRIPTION_KEY=your-sec-subscription-key-here

# Google Sheets Data Sources
GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id-here
GOOGLE_PVD_SPREADSHEET_ID=your-google-pvd-spreadsheet-id-here

# Provident Fund (PVD) Configuration
SEC_PVD_PROJ_ID=your-sec-pvd-proj-id-here
SEC_PVD_BASE_URL=https://api.sec.or.th/v1/pvd
